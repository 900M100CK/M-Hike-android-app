<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MhikeApp">

        <!-- LAUNCHER: Hike list is the entry point -->
        <activity
            android:name=".HikeListActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="Login"
            android:windowSoftInputMode="adjustResize" />

        <!-- Kept for compatibility; redirects to HikeListActivity immediately -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Feature A: Add / Edit hike form -->
        <activity
            android:name=".AddHikeActivity"
            android:exported="false"
            android:label="@string/title_add_hike"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".HikeListActivity" />

        <!-- Feature B: Hike detail + observations -->
        <activity
            android:name=".HikeDetailActivity"
            android:exported="false"
            android:label="@string/title_hike_detail"
            android:parentActivityName=".HikeListActivity" />

        <!-- Feature C: Add / Edit observation -->
        <activity
            android:name=".AddObservationActivity"
            android:exported="false"
            android:label="@string/title_add_observation"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".HikeDetailActivity" />

        <!-- Feature D: Advanced search & filter -->
        <activity
            android:name=".SearchFilterActivity"
            android:exported="false"
            android:label="@string/title_search_filter"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".HikeListActivity" />

    </application>

</manifest>