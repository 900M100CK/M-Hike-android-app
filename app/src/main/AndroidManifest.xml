<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Feature G1: location access for map & GPS capture -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Feature G1: network access for OpenStreetMap tiles (osmdroid) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Feature G2: photo capture for hikes -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MhikeApp">

        <!-- Feature G2: file access for camera photo capture -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- LAUNCHER: Hike list is the entry point -->
        <activity
            android:name=".HikeListActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="Login"
            android:windowSoftInputMode="adjustResize" />

        <!-- Kept for compatibility; redirects to HikeListActivity immediately -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Feature A: Add / Edit hike form -->
        <activity
            android:name=".AddHikeActivity"
            android:exported="false"
            android:label="@string/title_add_hike"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".HikeListActivity" />

        <!-- Feature B: Hike detail + observations -->
        <activity
            android:name=".HikeDetailActivity"
            android:exported="false"
            android:label="@string/title_hike_detail"
            android:parentActivityName=".HikeListActivity" />

        <!-- Feature C: Add / Edit observation -->
        <activity
            android:name=".AddObservationActivity"
            android:exported="false"
            android:label="@string/title_add_observation"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".HikeDetailActivity" />

        <!-- Feature D: Advanced search & filter -->
        <activity
            android:name=".SearchFilterActivity"
            android:exported="false"
            android:label="@string/title_search_filter"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".HikeListActivity" />

        <!-- Feature G1: trail location map (osmdroid / OpenStreetMap) -->
        <activity
            android:name=".HikeMapActivity"
            android:exported="false"
            android:label="@string/title_hike_map"
            android:parentActivityName=".HikeDetailActivity" />

    </application>

</manifest>