<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_add_observation.xml
  Feature C: Observation entry form.
  Material Design 3.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddObservationActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/title_add_observation" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Observation Title (required) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutObsTitle"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_obs_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextObsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="100"
                    android:imeOptions="actionNext"
                    android:contentDescription="@string/hint_obs_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Observation Time (required) – tapping opens TimePickerDialog -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutObsTime"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_obs_time"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_time"
                app:endIconContentDescription="@string/hint_obs_time">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextObsTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none"
                    android:contentDescription="@string/hint_obs_time" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Outdoor Temperature (°C) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutObsTemp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_obs_temp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextObsTemp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal|numberSigned"
                    android:contentDescription="@string/hint_obs_temp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- G4: Weather hint — shows current + next-hour temperature after API fetch -->
            <TextView
                android:id="@+id/textViewWeatherHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="4dp"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                android:text="" />

            <!-- Step Count -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutObsStepCount"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_obs_step_count">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextObsStepCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:contentDescription="@string/hint_obs_step_count" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Photo Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imageObsPhotoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Observation photo preview"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCapturePhoto"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/action_capture_photo"
                        app:icon="@drawable/ic_hiking" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonPickPhoto"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/action_pick_photo"
                        app:icon="@drawable/ic_hiking" />
                </LinearLayout>

            </LinearLayout>

            <!-- Comment (optional) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutObsComment"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="@string/hint_obs_comment"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_mic"
                app:endIconContentDescription="Voice input">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextObsComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:gravity="top|start"
                    android:contentDescription="@string/hint_obs_comment" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSaveObservation"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/action_save"
                android:textSize="16sp"
                android:contentDescription="@string/action_save" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
