<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_hike_list.xml
  Main list screen: Toolbar, search bar, RecyclerView, FAB, and action buttons.
  Material Design 3 — 8dp grid spacing throughout.
  FIX: Removed FloatingActionButtonBehavior (class not found at runtime).
       Using FrameLayout overlay for FAB positioning instead of CoordinatorLayout behavior.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HikeListActivity">

    <!-- AppBar with Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main content scrollable area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="88dp">

            <!-- Search bar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutSearch"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/hint_search_hike_name"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:contentDescription="@string/hint_search_hike_name" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Action row: Filter + Delete All -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFilter"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/action_filter"
                    android:layout_marginEnd="8dp"
                    app:icon="@drawable/ic_filter" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonDeleteAll"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/action_delete_all"
                    app:iconTint="@color/md_error"
                    app:strokeColor="@color/md_error" />

            </LinearLayout>

            <!-- Empty state message -->
            <TextView
                android:id="@+id/textEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/msg_no_hikes"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:padding="32dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Hike list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHikes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_hike"
                tools:itemCount="4" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB: positioned via CoordinatorLayout gravity (no custom Behavior class needed) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddHike"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/action_add_hike"
        android:contentDescription="@string/action_add_hike"
        app:icon="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
