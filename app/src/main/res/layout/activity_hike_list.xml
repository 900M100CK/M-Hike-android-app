<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_hike_list.xml
  Main list screen: Material Design 3 Forest Green UI.
  Includes elevation, illustrated empty state, pill filter buttons, and extended FAB.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    tools:context=".HikeListActivity">

    <!-- AppBar with Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge"
            app:titleTextColor="@color/md_primary" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_background"
            app:tabIndicatorColor="@color/md_primary"
            app:tabSelectedTextColor="@color/md_primary"
            app:tabTextColor="@color/md_on_surface_variant">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Hikes" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online Feed" />

        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main content area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="96dp">

            <!-- Live Weather Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLiveWeather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/md_primary_container"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_hiking"
                        app:tint="@color/md_on_primary_container"
                        android:contentDescription="@null"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Weather"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/md_on_primary_container" />

                        <TextView
                            android:id="@+id/textLiveWeather"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading weather..."
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/md_on_primary_container"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Search bar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutSearch"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_search_hike_name"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/md_primary"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:contentDescription="@string/hint_search_hike_name" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Action row: Filter + Reset + Add Samples -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="end">

                <!-- Filter Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFilter"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/action_filter"
                    android:textColor="@color/md_primary"
                    android:layout_marginEnd="8dp"
                    app:icon="@drawable/ic_filter"
                    app:iconTint="@color/md_primary"
                    app:strokeColor="@color/md_outline"
                    app:cornerRadius="22dp" />

                <!-- Add Samples Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAddSamples"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/action_add_samples"
                    android:textColor="@color/md_primary"
                    android:layout_marginEnd="8dp"
                    app:icon="@drawable/ic_hiking"
                    app:iconTint="@color/md_primary"
                    app:strokeColor="@color/md_outline"
                    app:cornerRadius="22dp" />

                <!-- Delete All Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonDeleteAll"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/action_reset_db"
                    android:textColor="@color/md_error"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/md_error"
                    app:strokeColor="@color/md_error"
                    app:cornerRadius="22dp" />

            </LinearLayout>

            <!-- Empty state layout container -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">

                <ImageView
                    android:id="@+id/imgEmptyState"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/ic_empty_hikes"
                    android:contentDescription="@null"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/textEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_no_hikes"
                    android:textAlignment="center"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/md_secondary"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Hike list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHikes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_hike"
                tools:itemCount="4" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Extended FAB with M3 Forest Green style -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddHike"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/action_add_hike"
        android:textColor="@color/md_on_primary"
        app:backgroundTint="@color/md_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/md_on_primary"
        android:contentDescription="@string/action_add_hike" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
