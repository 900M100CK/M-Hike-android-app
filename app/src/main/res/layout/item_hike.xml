<?xml version="1.0" encoding="utf-8"?>
<!--
  item_hike.xml
  RecyclerView card item for a single hike entry.
  Material Design 3 card with stroke, subtle elevation, tactile feedback,
  and mono-spaced numeric label hierarchy.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="1dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/md_surface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/md_surface_variant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:minHeight="64dp"
        android:gravity="center_vertical">

        <!-- Parking badge container (circular pill) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textParkingStatus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_parking_badge"
            android:layout_marginEnd="14dp"
            tools:text="P" />

        <!-- Main information column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Hike name -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textHikeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/md_on_surface"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Snowdon Summit Route" />

            <!-- Location & Date row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="3dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/md_secondary"
                    android:contentDescription="@null"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textHikeLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/md_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Snowdonia, Wales" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textHikeDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_secondary"
                    android:layout_marginStart="8dp"
                    tools:text="2026-08-01" />

            </LinearLayout>

            <!-- Difficulty badge + Length row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <!-- Difficulty badge pill -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textHikeDifficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_on_secondary_container"
                    android:textStyle="bold"
                    android:background="@drawable/bg_difficulty_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="10dp"
                    tools:text="Hard" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_hiking"
                    app:tint="@color/md_primary"
                    android:contentDescription="@null"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="4dp" />

                <!-- Length numeric metric -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textHikeLength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/md_primary"
                    android:textStyle="bold"
                    tools:text="14.5 km" />

            </LinearLayout>

        </LinearLayout>

        <!-- Delete icon button (48dp touch target) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDeleteHike"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/md_error"
            android:contentDescription="@string/action_delete"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
