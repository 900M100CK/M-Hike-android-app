<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_add_hike.xml
  Feature A: Hike entry form with all required and optional fields.
  All touch targets are ≥ 48dp. 8dp grid spacing. Material Design 3.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddHikeActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/title_add_hike" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============================================================ -->
            <!-- REQUIRED FIELDS section header                               -->
            <!-- ============================================================ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_required_fields"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="8dp" />

            <!-- Hike Name (required) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutName"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_hike_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="100"
                    android:imeOptions="actionNext"
                    android:contentDescription="@string/hint_hike_name" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Location (required) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutLocation"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_location"
                app:startIconDrawable="@drawable/ic_location">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="150"
                    android:imeOptions="actionNext"
                    android:contentDescription="@string/hint_location" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- G1 GPS capture: single-fix trailhead coordinates -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonUseMyLocation"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/use_my_location"
                android:textColor="@color/md_primary"
                app:icon="@drawable/ic_location"
                app:iconTint="@color/md_primary" />

            <TextView
                android:id="@+id/textCoordinates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/label_coordinates"
                android:paddingHorizontal="4dp"
                android:text="@string/coordinates_not_captured"
                android:textColor="@color/md_on_background"
                android:textSize="14sp" />

            <!-- Date (required) – tapping opens DatePickerDialog -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutDate"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_date"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconContentDescription="@string/hint_date">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none"
                    android:contentDescription="@string/hint_date" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Parking availability (required) – RadioGroup -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_parking"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="4dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupParking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioParkingYes"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/label_parking_yes"
                            android:layout_marginEnd="24dp"
                            android:checked="true"
                            android:contentDescription="@string/label_parking_yes" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioParkingNo"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/label_parking_no"
                            android:contentDescription="@string/label_parking_no" />

                    </RadioGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Length in km (required) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutLength"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_length"
                app:suffixText="@string/suffix_km">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionNext"
                    android:contentDescription="@string/hint_length" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Difficulty level (required) – Spinner wrapped in a card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_difficulty"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinnerDifficulty"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:contentDescription="@string/label_difficulty" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================================ -->
            <!-- OPTIONAL FIELDS section header                               -->
            <!-- ============================================================ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_optional_fields"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorSecondary"
                android:layout_marginBottom="8dp" />

            <!-- Description (optional) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutDescription"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_description">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:gravity="top|start"
                    android:contentDescription="@string/hint_description" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Custom Field 1 (optional) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutCustomField1"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_custom_field_1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextCustomField1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:contentDescription="@string/hint_custom_field_1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Custom Field 2 (optional) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutCustomField2"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="@string/hint_custom_field_2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextCustomField2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:contentDescription="@string/hint_custom_field_2" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Preview & Save button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPreviewSave"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/action_preview_save"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/action_preview_save" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
