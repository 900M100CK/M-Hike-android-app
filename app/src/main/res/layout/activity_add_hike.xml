<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_add_hike.xml
  Feature A: Hike entry & edit form with structured card sections.
  Material Design 3 Forest Green styling. All touch targets ≥ 48dp.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    tools:context=".AddHikeActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/title_add_hike"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge"
            app:titleTextColor="@color/md_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============================================================ -->
            <!-- SECTION 1: REQUIRED HIKE DETAILS                            -->
            <!-- ============================================================ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/md_surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_surface_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_required_fields"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/md_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Hike Name -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutName"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_hike_name"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLength="100"
                            android:imeOptions="actionNext"
                            android:contentDescription="@string/hint_hike_name" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Location -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutLocation"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_location"
                        app:startIconDrawable="@drawable/ic_location"
                        app:startIconTint="@color/md_primary"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLength="150"
                            android:imeOptions="actionNext"
                            android:contentDescription="@string/hint_location" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- GPS Capture Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonUseMyLocation"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/use_my_location"
                        android:textColor="@color/md_primary"
                        app:strokeColor="@color/md_primary"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_location"
                        app:iconTint="@color/md_primary" />

                    <!-- GPS Coordinates display -->
                    <TextView
                        android:id="@+id/textCoordinates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="@string/label_coordinates"
                        android:paddingHorizontal="6dp"
                        android:text="@string/coordinates_not_captured"
                        android:textColor="@color/md_secondary"
                        android:textSize="13sp" />

                    <!-- Date -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutDate"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_date"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_calendar"
                        app:endIconTint="@color/md_primary"
                        app:endIconContentDescription="@string/hint_date"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:inputType="none"
                            android:contentDescription="@string/hint_date" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Length in km -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutLength"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_length"
                        app:suffixText="@string/suffix_km"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextLength"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionNext"
                            android:contentDescription="@string/hint_length" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Parking Availability -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_parking"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/md_secondary"
                            android:layout_marginBottom="4dp" />

                        <RadioGroup
                            android:id="@+id/radioGroupParking"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radioParkingYes"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/label_parking_yes"
                                android:layout_marginEnd="24dp"
                                android:checked="true"
                                android:contentDescription="@string/label_parking_yes" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radioParkingNo"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/label_parking_no"
                                android:contentDescription="@string/label_parking_no" />

                        </RadioGroup>
                    </LinearLayout>

                    <!-- Difficulty Spinner Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_difficulty"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/md_secondary"
                            android:layout_marginBottom="4dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:strokeColor="@color/md_outline"
                            app:strokeWidth="1dp"
                            app:cardElevation="0dp"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="@color/md_surface">

                            <Spinner
                                android:id="@+id/spinnerDifficulty"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:paddingHorizontal="8dp"
                                android:contentDescription="@string/label_difficulty" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================================ -->
            <!-- SECTION 2: OPTIONAL NOTES & DETAILS                         -->
            <!-- ============================================================ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/md_surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_surface_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_optional_fields"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/md_secondary"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Hike Cover Photo Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/imageHikePhotoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:contentDescription="@string/hint_hike_name"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonCaptureHikePhoto"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="@string/action_capture_photo"
                                android:textColor="@color/md_primary"
                                app:strokeColor="@color/md_primary"
                                app:icon="@drawable/ic_camera"
                                app:iconTint="@color/md_primary"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonPickHikePhoto"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="@string/action_pick_photo"
                                android:textColor="@color/md_primary"
                                app:strokeColor="@color/md_primary"
                                app:icon="@drawable/ic_photo"
                                app:iconTint="@color/md_primary"
                                android:layout_marginStart="6dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Description -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutDescription"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_description"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_mic"
                        app:endIconContentDescription="Voice input"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="3"
                            android:gravity="top|start"
                            android:contentDescription="@string/hint_description" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Custom Field 1 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutCustomField1"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_custom_field_1"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextCustomField1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:contentDescription="@string/hint_custom_field_1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Custom Field 2 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutCustomField2"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_custom_field_2"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextCustomField2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:contentDescription="@string/hint_custom_field_2" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPreviewSave"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/action_preview_save"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:layout_marginBottom="24dp"
                android:contentDescription="@string/action_preview_save" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
