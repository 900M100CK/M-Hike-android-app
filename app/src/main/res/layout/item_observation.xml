<?xml version="1.0" encoding="utf-8"?>
<!--
  item_observation.xml
  RecyclerView list item for a single observation entry.
  Material Design 3 Forest Green styling.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="4dp"
    app:cardElevation="1dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/md_surface"
    app:strokeColor="@color/md_surface_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:minHeight="56dp"
        android:gravity="center_vertical">

        <!-- Info column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textObsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/md_on_surface"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Spotted a Red Kite" />

            <!-- Observation Photo Preview -->
            <ImageView
                android:id="@+id/imageObsItemPhoto"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:layout_marginBottom="6dp"
                android:contentDescription="Observation photo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_time"
                    app:tint="@color/md_primary"
                    android:contentDescription="@null"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/textObsTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/md_primary"
                    android:textStyle="bold"
                    tools:text="10:34" />

                <!-- Temp & Step badges -->
                <TextView
                    android:id="@+id/textObsBadgeDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/md_secondary"
                    android:layout_marginStart="12dp"
                    tools:text="🌡 25°C • 👣 3,400 steps" />

            </LinearLayout>

            <TextView
                android:id="@+id/textObsComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/md_secondary"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp"
                tools:text="Circling overhead near the ridge, beautiful wingspan." />

        </LinearLayout>

        <!-- Edit & Delete actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditObs"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/md_primary"
                android:contentDescription="@string/action_edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDeleteObs"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/md_error"
                android:contentDescription="@string/action_delete" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
