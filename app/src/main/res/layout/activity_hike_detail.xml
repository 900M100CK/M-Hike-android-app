<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_hike_detail.xml
  Hike detail + observations list screen. Uses NestedScrollView to allow
  the observations RecyclerView to scroll as part of the page.
  Material Design 3.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HikeDetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/title_hike_detail" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hike name (hero) -->
            <TextView
                android:id="@+id/textDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:layout_marginBottom="4dp"
                tools:text="Snowdon Summit Route" />

            <!-- Detail card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Location row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_location"
                            android:contentDescription="@null"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/textDetailLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="Snowdonia, Wales" />

                    </LinearLayout>

                    <!-- Date row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_calendar"
                            android:contentDescription="@null"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/textDetailDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="2024-07-20" />

                    </LinearLayout>

                    <!-- Length row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_hiking"
                            android:contentDescription="@null"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/textDetailLength"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="14.5 km" />

                    </LinearLayout>

                    <!-- Difficulty row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_difficulty"
                            android:contentDescription="@null"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/textDetailDifficulty"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="Hard" />

                    </LinearLayout>

                    <!-- Parking row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_parking"
                            android:contentDescription="@null"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/textDetailParking"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="Parking Available" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Optional: Description -->
            <TextView
                android:id="@+id/textDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:text="A challenging route via Pyg Track with stunning views." />

            <!-- Optional: Custom field 1 -->
            <TextView
                android:id="@+id/textDetailCustom1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:layout_marginBottom="4dp"
                android:visibility="gone"
                tools:text="Note 1" />

            <!-- Optional: Custom field 2 -->
            <TextView
                android:id="@+id/textDetailCustom2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                tools:text="Note 2" />

            <!-- Edit hike button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditHike"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/action_edit_hike"
                android:layout_marginBottom="24dp" />

            <!-- ============================================================ -->
            <!-- Observations section                                          -->
            <!-- ============================================================ -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_observations"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAddObservation"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/action_add_observation"
                    app:icon="@drawable/ic_add" />

            </LinearLayout>

            <TextView
                android:id="@+id/textNoObservations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/msg_no_observations"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAlignment="center"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Observations RecyclerView (nested, scroll disabled) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerObservations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_observation"
                tools:itemCount="3" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
