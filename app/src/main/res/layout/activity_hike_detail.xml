<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_hike_detail.xml
  Hike detail + observations list screen.
  Material Design 3 Forest Green styling with hero metrics and illustrated empty states.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    tools:context=".HikeDetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/title_hike_detail"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge"
            app:titleTextColor="@color/md_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hero Cover Photo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetailCover"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageDetailCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/hint_hike_name" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Hero Section: Title -->
            <TextView
                android:id="@+id/textDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/md_primary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                tools:text="Snowdon Summit Route" />

            <!-- Core Hike Metrics Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/md_surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_surface_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Location Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/md_primary"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/textDetailLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/md_on_surface"
                            tools:text="Snowdonia, Wales" />

                    </LinearLayout>

                    <!-- Date Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/md_primary"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/textDetailDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/md_on_surface"
                            tools:text="2026-08-01" />

                    </LinearLayout>

                    <!-- Length Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_hiking"
                            app:tint="@color/md_primary"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/textDetailLength"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/md_on_surface"
                            android:textStyle="bold"
                            tools:text="14.5 km" />

                    </LinearLayout>

                    <!-- Difficulty Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_difficulty"
                            app:tint="@color/md_primary"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/textDetailDifficulty"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/md_on_surface"
                            tools:text="Hard" />

                    </LinearLayout>

                    <!-- Parking Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_parking"
                            app:tint="@color/md_primary"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/textDetailParking"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/md_on_surface"
                            tools:text="Parking Available" />

                    </LinearLayout>

                    <!-- View Map Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonViewMap"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/map_view_label"
                        android:textColor="@color/md_on_primary_container"
                        app:backgroundTint="@color/md_primary_container"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_location"
                        app:iconTint="@color/md_on_primary_container" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Optional: Description Block -->
            <TextView
                android:id="@+id/textDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_on_surface"
                android:background="@drawable/bg_difficulty_badge"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:text="A challenging route via Pyg Track with stunning views." />

            <!-- Optional: Custom field 1 -->
            <TextView
                android:id="@+id/textDetailCustom1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/md_secondary"
                android:layout_marginBottom="4dp"
                android:visibility="gone"
                tools:text="Note 1" />

            <!-- Optional: Custom field 2 -->
            <TextView
                android:id="@+id/textDetailCustom2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/md_secondary"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                tools:text="Note 2" />

            <!-- Action Button Row: Edit Hike & Export PDF -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonEditHike"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/action_edit_hike"
                    android:textColor="@color/md_primary"
                    app:strokeColor="@color/md_primary"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="@color/md_primary"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonExportPdf"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/action_export_pdf"
                    android:textColor="@color/md_on_primary_container"
                    app:backgroundTint="@color/md_primary_container"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_hiking"
                    app:iconTint="@color/md_on_primary_container"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <!-- ============================================================ -->
            <!-- OBSERVATIONS SECTION                                         -->
            <!-- ============================================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_observations"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/md_primary"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAddObservation"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/action_add_observation"
                    android:textColor="@color/md_on_primary_container"
                    app:backgroundTint="@color/md_primary_container"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/md_on_primary_container" />

            </LinearLayout>

            <!-- Empty State for Observations -->
            <LinearLayout
                android:id="@+id/layoutEmptyObs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textNoObservations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_no_observations"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/md_secondary"
                    android:textAlignment="center"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Observations RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerObservations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_observation"
                tools:itemCount="3" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
