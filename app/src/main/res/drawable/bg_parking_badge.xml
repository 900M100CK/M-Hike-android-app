<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_parking_badge.xml
  Circular badge for parking status in item_hike.xml.
  Uses a hardcoded colour instead of ?attr/colorPrimary because
  shape drawables cannot resolve theme attributes on all API levels.
  The green matches md_primary (#386A1F).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#386A1F" />
</shape>
